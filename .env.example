DATABASE_URL="file:./dev.db"
MEDIA_DIR=./data/media

# Claude (Trend-Research + Scripts)
ANTHROPIC_API_KEY=
CLAUDE_MODEL=claude-opus-5

# Higgsfield (open.higgsfield.ai -> API Keys) Format KEY_ID:KEY_SECRET
HF_CREDENTIALS=
HF_BASE_URL=https://api.higgsfield.ai
HF_SPEAK_ENDPOINT=/v1/speak/higgsfield
HF_IMAGE_ENDPOINT=/v1/text2image/soul
HF_I2V_ENDPOINT=/v1/image2video/dop
HF_I2V_MODEL=dop-turbo
# mid = günstiger, high = beste Qualität (ca. 2–4x teurer)
HF_QUALITY=mid

# ElevenLabs (Stimmen)
ELEVENLABS_API_KEY=
ELEVENLABS_MODEL=eleven_multilingual_v2

# Ayrshare (Posting/Scheduling). Profile-Key pro Marke im Dashboard.
AYRSHARE_API_KEY=

# Optional: echte virale Daten (TikTok/Instagram) via Apify
APIFY_TOKEN=

# Öffentliche URL der App (Webhooks + Medien-Links). Leer = Polling.
PUBLIC_BASE_URL=

# Dashboard-Zugang (Basic Auth). Leer = offen (nur lokal!)
DASHBOARD_USER=admin
DASHBOARD_PASSWORD=
# für /api/tick (Serverless-Cron)
CRON_SECRET=

WORKER_INTERVAL_SEC=20
SUBTITLE_FONT=DejaVu Sans
BACKGROUND_MUSIC_URL=

# Preis-Overrides (USD) – siehe src/lib/costs.ts
# PRICE_HF_SPEAK_PER_SEC=0.15
# PRICE_HF_SOUL_IMAGE=0.18
# PRICE_HF_DOP=0.4
# PRICE_ELEVEN_PER_1K=0.2

# true = ohne API-Keys mit Dummy-Daten durchlaufen (Demo, ffmpeg-Schnitt läuft echt)
MOCK_MODE=false
