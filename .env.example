DATABASE_URL="file:./dev.db"

# Claude (Trend-Research + Scripts)
ANTHROPIC_API_KEY=
CLAUDE_MODEL=claude-opus-5

# Higgsfield (open.higgsfield.ai -> API Keys) Format KEY_ID:KEY_SECRET
HF_CREDENTIALS=
HF_BASE_URL=https://api.higgsfield.ai
HF_VIDEO_ENDPOINT=/v1/speak/higgsfield
HF_QUALITY=high

# ElevenLabs (feste Influencer-Stimme)
ELEVENLABS_API_KEY=
ELEVENLABS_MODEL=eleven_multilingual_v2

# Ayrshare (Posting/Scheduling Instagram, TikTok, Facebook)
AYRSHARE_API_KEY=
# optional bei Business-Plan / mehreren Kunden-Profilen
AYRSHARE_PROFILE_KEY=

# Öffentliche URL der App (für Higgsfield-Webhook). Leer = Polling.
PUBLIC_BASE_URL=

# Dashboard-Zugang (Basic Auth). Leer = offen (nur lokal!)
DASHBOARD_USER=admin
DASHBOARD_PASSWORD=

# Worker
WORKER_INTERVAL_SEC=20
# Autopilot: Genehmigungs-Gates überspringen (true/false)
AUTO_APPROVE_SCRIPTS=false
AUTO_APPROVE_VIDEOS=false
# Automatische Runs (cron, leer = aus). Bsp: täglich 6 Uhr
AUTO_RUN_CRON=
AUTO_RUN_NICHE=
# Posting-Slots (Europe/Berlin), kommagetrennt HH:MM
POST_SLOTS=11:30,18:00
TIMEZONE=Europe/Berlin

# true = ohne API-Keys mit Dummy-Daten durchlaufen (Demo)
MOCK_MODE=false
CRON_SECRET=
